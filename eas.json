{
  "cli": { "version": ">= 16.0.0" },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "env": { "EXPO_PUBLIC_ENABLE_REMOTE_PUSH": "true" },
      "android": { "buildType": "apk" }
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "env": { "EXPO_PUBLIC_ENABLE_REMOTE_PUSH": "true" },
      "android": { "buildType": "apk" }
    },
    "production": {
      "environment": "production",
      "env": { "EXPO_PUBLIC_ENABLE_REMOTE_PUSH": "true" }
    }
  }
}
